# ── SwaLekhan AI server (all OPTIONAL — the app works with none of these set) ──

# Port for the SwaLekhan API (Vite dev server proxies /api to it)
PORT=8787

# SQLite database file (created automatically)
SWALEKHAN_DB_PATH=./data/swalekhan.db

# Enables teacher self-registration. Leave empty to disable it (students can never become teachers).
TEACHER_INVITE_CODE=

# Auto-delete assignments older than N days (0 or empty = keep until the student deletes them)
RETENTION_DAYS=

# Max upload size in MB (default 5)
SWALEKHAN_MAX_FILE_MB=5

# OPTIONAL: Google Gemini key. NOT required. If set, a server-side language-model review is
# blended with the heuristic engine. If unset or failing, the heuristic engine runs alone.
# The key is only ever read on the server; it is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Frontend (Vite) ──
# SwaLekhan auto-detects the API server. With no server (e.g. a static Vercel deploy) it runs in
# "browser mode": accounts and reports are stored in the browser's localStorage. Force a mode with:
# VITE_SWALEKHAN_MODE=local
# Teacher invite code used in browser mode (default TEACHER2026)
# VITE_TEACHER_INVITE_CODE=TEACHER2026
