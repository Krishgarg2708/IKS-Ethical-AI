{
  "name": "iks-ethical-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c green,yellow \"npm:dev:web\" \"npm:dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,api -c green,yellow \"npm:dev:web\" \"npm:dev:server\"",
    "start": "tsx server/index.ts",
    "seed:demo": "tsx server/seed-demo.ts",
    "test": "node --test --import tsx server/tests/*.test.ts",
    "dev:web": "vite --port=3000 --host=0.0.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "pdfkit": "^0.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "unpdf": "^2.2.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}